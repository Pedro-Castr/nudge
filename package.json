{
  "name": "nudge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node infra/scripts/wait-for-next.js",
    "lint": "eslint .",
    "test": "npm run services:up && concurrently --hide 0 -k -s command-1 \"next dev\" \"cross-env NODE_OPTIONS=--experimental-vm-modules jest\"",
    "posttest": "npm run services:down",
    "test:watch": "jest --watchAll",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate -m infra/migrations --template-file-name infra/migration-template.cjs create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:ts:check": "tsc --noEmit",
    "scan:staged": "gitleaks-secret-scanner",
    "scan:all": "gitleaks-secret-scanner --diff-mode all",
    "commit": "cz",
    "prepare": "husky"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5",
    "dotenv-expand": "^1000.0.0",
    "next": "^16.4.0",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "commitizen": "^4.3.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "gitleaks-secret-scanner": "^2.1.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.9.9",
    "set-cookie-parser": "^3.1.3",
    "typescript": "~6.0.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
